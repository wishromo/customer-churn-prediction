import pickle
import pandas as pd
with open('churn_pipeline.pkl', 'rb') as file:
    loaded_pipe = pickle.load(file)


new_customer = pd.DataFrame([{
    'gender': 'Female',
    'SeniorCitizen': 0,
    'Partner': 'Yes',
    'Dependents': 'No',
    'tenure': 5,
    'PhoneService': 'Yes',
    'MultipleLines': 'No',
    'InternetService': 'Fiber optic',
    'OnlineSecurity': 'No',
    'OnlineBackup': 'No',
    'DeviceProtection': 'No',
    'TechSupport': 'No',
    'StreamingTV': 'Yes',
    'StreamingMovies': 'Yes',
    'Contract': 'Month-to-month',
    'PaperlessBilling': 'Yes',
    'PaymentMethod': 'Electronic check',
    'MonthlyCharges': 85.50,
    'TotalCharges': 420.00
}])


loaded_pipe.predict(new_customer)


loaded_pipe.predict_proba(new_customer)


prob = loaded_pipe.predict_proba(new_customer)

print("No Churn Probability:", prob[0][0])
print("Churn Probability:", prob[0][1])


print("No Churn:", round(prob[0][0] * 100, 2), "%")
print("Churn:", round(prob[0][1] * 100, 2), "%")


prediction = loaded_pipe.predict(new_customer)[0]
prob = loaded_pipe.predict_proba(new_customer)[0]

print("Prediction:", prediction)
print("No Churn Probability:", round(prob[0] * 100, 2), "%")
print("Churn Probability:", round(prob[1] * 100, 2), "%")



